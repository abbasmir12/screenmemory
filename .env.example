# Copy this file to ".env" and edit. Lines starting with # are ignored.

# ---- The model: ANY OpenAI-compatible endpoint with vision + tool calling ----

# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b

# Google AI Studio (hosted Gemma 4) - uncomment these 3 and comment the 3 above:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=YOUR_KEY
# LLM_MODEL=gemma-4-26b-a4b-it

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=YOUR_KEY
# LLM_MODEL=google/gemma-4-31b-it:free

# ---- Optional ----
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=screen_memory
# SHOTS_DIR=C:\Users\YOU\Pictures\Screenshots
# LLM_DELAY=4.5
